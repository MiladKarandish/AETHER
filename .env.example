# ————————————————————————————————————————————————————————————————
# Google Drive (optional)
# ————————————————————————————————————————————————————————————————
# AETHER runs fully without any of these. Add them to save and serve music
# from a Google Drive account instead of (or alongside) the browser's local
# OPFS library.
#
# Setup:
#   1. Google Cloud Console -> enable the "Google Drive API"
#   2. Credentials -> OAuth client ID -> Web application
#   3. Add "http://localhost:3000/api/drive/callback" as an authorised
#      redirect URI (and the matching https:// URL when you deploy)
#   4. Copy .env.example to .env.local and fill in the values below
#
# AETHER asks for the narrow `drive.file` scope, so it can only ever see the
# files it created itself — never the rest of your Drive.

# From the OAuth client. All three are required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# 32+ random characters, used to encrypt the OAuth session cookie.
# Generate one with:  openssl rand -base64 32
# Changing this invalidates every connected browser (they must reconnect).
AETHER_SESSION_SECRET=

# Optional: rename AETHER's folder inside Drive.
# GOOGLE_DRIVE_FOLDER=AETHER Music
